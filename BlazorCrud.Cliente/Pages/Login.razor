@page "/"
@layout LoginLayout

@inject HttpClient httpClient
@using BlazorCrud.Cliente.ExtensionesLogin
@using BlazorCrud.Shared

@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider autenticacionProvider
@inject NavigationManager navManager

<div class="row mt-5">
    <div class="col-lg-4 offset-4 border">
        <div class="mb-3 text-center">
            <h3>LOGIN</h3>
        </div>

        <!-- Mostrar el mensaje de error si hay un error de autenticación -->
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger">@mensajeError</div>
        }

        <div class="mb-3">
            <label>Correo</label>
            <input @bind="login.Correo" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Contraseña</label>
            <input @bind="login.Contrasenia" type="password" class="form-control" />
        </div>

        <div class="mb-3">
            <button @onclick="IniciarSesion" class="btn btn-primary">Iniciar Sesión</button>
        </div>
        

        <hr />
        <div class="mb-3">
            <a class="btn btn-primary" href="registrarse">Registrarse</a>
        </div>

    </div>
</div>

@code {
    private LoginDTO login = new LoginDTO();
    private string mensajeError = string.Empty; // Para almacenar el mensaje de error

    private async Task IniciarSesion()
    {
        mensajeError = string.Empty; // Reiniciar el mensaje de error al intentar iniciar sesión

        var loginResponse = await httpClient.PostAsJsonAsync("api/Usuario/Login", login);

        if (loginResponse.IsSuccessStatusCode)
        {
            var sesionUsuario = await loginResponse.Content.ReadFromJsonAsync<SesionDTO>();
            var autenticacionExt = (AutenticacionExtension)autenticacionProvider;
            await autenticacionExt.ActualizarEstadoAutenticacion(sesionUsuario);

            navManager.NavigateTo("/home");
        }
        else if (loginResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            // Capturar el mensaje de error cuando el servidor retorna 401 (Unauthorized)
            mensajeError = "Correo y/o contraseña incorrectos.";
        }
        else
        {
            // Capturar otros posibles errores
            mensajeError = "Ocurrió un error inesperado al intentar iniciar sesión.";
        }
    }
}
